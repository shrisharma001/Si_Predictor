# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------- Virtual environments
venv/
.venv/
env/

# ---------------------------------------------------------------- Secrets
.env
.env.*

# ---------------------------------------------------------------- Dataset (not ours to redistribute; see README "Data")
# The folders are kept (with an empty .gitkeep) so `docker compose` finds them; their contents are not pushed.
data/*
!data/.gitkeep
*.xlsx
*.xls

# ---------------------------------------------------------------- Trained models (pickles tied to library versions; rebuild with train_final.py)
model/*
!model/.gitkeep
model_docker/*
!model_docker/.gitkeep
*.pkl
*.joblib

# ---------------------------------------------------------------- CSV files
# Ignored by default (datasets, uploads, scratch exports) ...
*.csv
# ... except the experiment results, which back every number in the paper.
!results/*.csv

# ---------------------------------------------------------------- Paper drafts and documents
*.docx
*.pdf
.~lock.*

# ---------------------------------------------------------------- Logs
*.log

# ---------------------------------------------------------------- IDE / editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db